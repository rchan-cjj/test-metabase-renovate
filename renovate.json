{
    "$schema": "https://docs.renovatebot.com/renovate-schema.json",
    "extends": [
        "github>1024pix/renovate-config:buildpack-project"
    ],
    "enabled": true,
    "customManagers": [
        {
            "customType": "regex",
            "managerFilePatterns": [
                "/^bin/version$/"
            ],
            "matchStrings": [
                "^(?<currentValue>\\S+)\\n?$"
            ],
            "depNameTemplate": "metabase/metabase",
            "datasourceTemplate": "github-releases",
            "extractVersionTemplate": "v(?<version>.*)"
        }
    ]
}
